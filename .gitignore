.venv/

# The .env.* wildcard is not redundant: Windows Notepad silently appends .txt,
# and ".env" alone does not catch ".env.txt". The !.env.example negation has to
# come AFTER the wildcard, or the template — the one file that documents which
# variables exist — would never make it into a commit.
.env
.env.*
!.env.example

# A wildcard rather than "secrets/": git will not re-include a file from inside
# an ignored directory, so ignoring the directory itself would make the .gitkeep
# negation worthless and the directory would disappear from the clone.
secrets/*
!secrets/.gitkeep

out/*
!out/.gitkeep

# Claude Code's working notes, the vendored devy harness and its change specs.
# None of it is part of the tool: .claude/ and .harn/ hold 80-odd files of agent
# skills, slash commands and design documents, reinstallable from their own
# source, that one "git add -A" would otherwise put on the front page of a
# repository whose whole purpose is being readable by a stranger — and removing
# them in a later commit would leave them in the log forever.
#
# Whole directories rather than the "secrets/*" wildcard used above, because
# nothing inside either of them has to be negated back in. CLAUDE.md needs its
# own line: it sits at the root, not under .claude/. The former
# .claude/settings.local.json line is now redundant and gone.
CLAUDE.md
.claude/
.harn/

__pycache__/
*.pyc

# pytest-cov drops its data file at the repo root; .pytest_cache/ and
# .ruff_cache/ each write their own internal .gitignore, .coverage does not.
.coverage
.coverage.*

Thumbs.db
.DS_Store
