# ga4-realtime -- secrets, and nothing else
#
# Copy this file to `.env` beside your `ga4-realtime.toml` and fill in what
# you want kept out of the config file. The real `.env` is gitignored; this
# template is not.
#
# Settings live in `ga4-realtime.toml` (see `ga4-realtime.example.toml`).
# This file exists for one job: any string value in that config may be
# written as ${VAR}, and the value is read from here or from the environment.
# That is what keeps a service-account path, or a property ID, out of a file
# you might paste into an issue.
#
#   # in ga4-realtime.toml
#   [[sites]]
#   name        = "mysite"
#   property_id = "${GA4_PROPERTY_ID_MYSITE}"
#   credentials = "${GA4_CREDENTIALS}"
#
# The names are yours to choose -- the ones below are only a suggestion. An
# unset or empty variable is an error naming both the variable and the config
# key that wanted it; it is never quietly substituted with an empty string.
# The real environment wins over this file, so `GA4_CREDENTIALS=... ga4-
# realtime doctor` is a one-off override that edits nothing.

# The service account's JSON key. A relative path resolves against the
# directory holding the config file, never the directory you ran the command
# from.
GA4_CREDENTIALS=secrets/ga4-service-account.json

# The NUMERIC property ID -- GA4 -> Admin -> Property settings -> Property ID.
# NOT the measurement ID (G-XXXXXXXXXX) that gtag.js uses in the browser: that
# one is for the page and not for the API, and using it produces a
# PermissionDenied that never explains the cause. The tool rejects the G-
# format by name, before any call, precisely because the API's own error does
# not help.
GA4_PROPERTY_ID_MYSITE=

# Two variables that used to matter and no longer do:
#
#   GA4_PROPERTY_ID                 its value moved into [[sites]].property_id
#   GOOGLE_APPLICATION_CREDENTIALS  no longer read
#
# Both were process-global, which is precisely why they had to go: two sites
# may use two different service accounts, and one environment variable cannot
# hold both. Credentials are now passed to the Google clients explicitly, per
# site, from the `credentials` key in the config.
